# ── Общее ─────────────────────────────────────────────────────────────────────
welcome = 👋 Привет, <b>{ $name }</b>{ $badge }!

    🎵 Я помогу найти и скачать любую музыку.

    Просто напиши название песни или исполнителя.

help-text =
    <b>Как пользоваться:</b>

    1. Напиши название трека или исполнителя
    2. Выбери нужный трек из списка
    3. Получи аудиофайл

    <b>Команды:</b>
    /start — главное меню
    /history — история поиска
    /favorites — избранные треки
    /popular — популярные запросы
    /settings — настройки
    /help — справка

# ── Поиск ─────────────────────────────────────────────────────────────────────
search-placeholder = Введите название трека...
search-too-short = ✏️ Введите название трека (минимум 2 символа).
search-processing = 🔍 Ищу...
search-queue-position = ⏳ Вы в очереди: <b>#{ $position }</b>
    Запрос: <code>{ $query }</code>
search-results-header = 🎵 <b>Результаты:</b> <code>{ $query }</code>
    Найдено: { $total } треков
search-not-found = 😔 По запросу <code>{ $query }</code> ничего не найдено.
search-error = ❌ Ошибка при поиске. Попробуйте позже.
search-timeout = ⏰ Время ожидания истекло. Попробуйте ещё раз.
search-queue-full = 🔴 Сервис перегружен. Попробуйте через минуту.

# ── Скачивание ────────────────────────────────────────────────────────────────
download-processing = ⏳ Скачиваю...
download-caption = 🎵 { $artist } — { $title }
download-error = ❌ Не удалось получить трек. Попробуйте другой.
download-results-stale = ❌ Результаты устарели. Повторите поиск.

# ── История ───────────────────────────────────────────────────────────────────
history-title = 📜 <b>История поиска:</b>
history-empty = 📭 История поиска пуста.
history-clear = 🗑 Очистить историю
history-cleared = 🗑 История очищена.

# ── Подписка ──────────────────────────────────────────────────────────────────
subscription-required =
    📢 Для использования бота подпишитесь на каналы:

    { $channels }
subscription-check = ✅ Проверить подписку
subscription-success =
    ✅ Отлично! Вы подписаны на все каналы.

    Теперь вы можете пользоваться ботом.
subscription-fail = ❌ Вы ещё не подписались на все каналы:

    { $channels }

# ── Rate limit ────────────────────────────────────────────────────────────────
rate-limit-minute = ⏳ Слишком много запросов.
    Подождите <b>{ $seconds } сек</b>.
rate-limit-day = 📊 Дневной лимит исчерпан.
    Обновится через <b>{ $hours } ч { $minutes } мин</b>.
banned = 🚫 Вы заблокированы.

