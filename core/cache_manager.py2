"""
Централизованное управление Redis кэшем.
Фикс БАГ 3: единая сигнатура check_rate_limit.
"""
import hashlib
import json
import logging
import time
from dataclasses import asdict

from redis.asyncio import Redis

from sources.base import AudioFile, SearchResult

logger = logging.getLogger(__name__)


class CacheManager:
    KEY_SEARCH  = "search:{hash}"
    KEY_AUDIO   = "file:{unique_id}"
    KEY_RATE    = "user:{uid}:rate{suffix}:{bucket}"
    KEY_HISTORY = "user:{uid}:history"
    KEY_POPULAR = "popular:queries"

    TTL_SEARCH  = 3600
    TTL_AUDIO   = 86400
    TTL_POPULAR = 86400

    def __init__(self, redis: Redis) -> None:
        self._redis = redis

    def _search_key(self, query: str) -> str:
        normalized = " ".join(query.strip().lower().split())
        h = hashlib.md5(normalized.encode()).hexdigest()
        return self.KEY_SEARCH.format(hash=h)

    async def get_search(self, query: str) -> SearchResult | None:
        key  = self._search_key(query)
        data = await self._redis.get(key)
        if not data:
            return None
        try:
            return SearchResult(**json.loads(data))
        except Exception as e:
            logger.warning("Cache deserialize error %r: %s", key, e)
            return None

    async def set_search(self, query: str, result: SearchResult) -> None:
        key  = self._search_key(query)
        data = json.dumps(asdict(result))
        await self._redis.setex(key, self.TTL_SEARCH, data)

    async def get_audio(self, unique_id: str) -> AudioFile | None:
        key  = self.KEY_AUDIO.format(unique_id=unique_id)
        data = await self._redis.get(key)
        if not data:
            return None
        try:
            return AudioFile(**json.loads(data))
        except Exception as e:
            logger.warning("Audio cache error: %s", e)
            return None

    async def set_audio(self, audio: AudioFile) -> None:
        if not audio.telegram_unique_id:
            return
        key  = self.KEY_AUDIO.format(unique_id=audio.telegram_unique_id)
        data = json.dumps(asdict(audio))
        await self._redis.setex(key, self.TTL_AUDIO, data)

    async def check_rate_limit(
        self,
        user_id: int,
        max_requests: int = 5,
        window: int = 60,
        key_suffix: str = "",
    ) -> tuple[bool, int]:
        """
        Sliding window rate limit.
        Returns (allowed, retry_after_seconds).
        """
        bucket = int(time.time()) // window
        key    = self.KEY_RATE.format(uid=user_id, suffix=key_suffix, bucket=bucket)

        count = await self._redis.incr(key)
        if count == 1:
            await self._redis.expire(key, window)

        if count > max_requests:
            ttl = await self._redis.ttl(key)
            return False, max(int(ttl), 0)

        return True, 0

    async def get_history(self, user_id: int, limit: int = 20) -> list[str]:
        key = self.KEY_HISTORY.format(uid=user_id)
        raw = await self._redis.lrange(key, 0, limit - 1)
        return [r.decode() if isinstance(r, bytes) else r for r in raw]

    async def add_to_history(self, user_id: int, query: str) -> None:
        key = self.KEY_HISTORY.format(uid=user_id)
        await self._redis.lpush(key, query)
        await self._redis.ltrim(key, 0, 49)

    async def clear_history(self, user_id: int) -> None:
        await self._redis.delete(self.KEY_HISTORY.format(uid=user_id))

    async def increment_popular(self, query: str) -> None:
        normalized = " ".join(query.strip().lower().split())
        await self._redis.zincrby(self.KEY_POPULAR, 1, normalized)
        await self._redis.expire(self.KEY_POPULAR, self.TTL_POPULAR)

    async def get_popular(self, limit: int = 10) -> list[tuple[str, float]]:
        raw = await self._redis.zrevrangebyscore(
            self.KEY_POPULAR, "+inf", "-inf",
            start=0, num=limit, withscores=True,
        )
        return [
            ((q.decode() if isinstance(q, bytes) else q), float(score))
            for q, score in raw
        ]