BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/music_gateway
DB_PASSWORD=your_secure_password

# Redis
REDIS_URL=redis://localhost:6379/0

# Pyrogram (userbot)
PYROGRAM_API_ID=12345
PYROGRAM_API_HASH=abcdef1234567890

# FastAPI internal API
API_SECRET_KEY=your_api_secret_key_32_chars_min
API_HOST=0.0.0.0
API_PORT=8000

# Cache TTL (seconds)
CACHE_SEARCH_TTL=3600
CACHE_AUDIO_TTL=86400
CACHE_POPULAR_TTL=86400

# Rate limiting
RATE_LIMIT_MINUTE=5
RATE_LIMIT_DAY=100

# Scheduler
SCHEDULER_TIMEZONE=UTC

# Monitoring
MONITOR_INTERVAL=30
WATCHDOG_CHAT_ID=your_admin_chat_id

# Inline mode
INLINE_CACHE_TIME=60
INLINE_MAX_RESULTS=20
INLINE_TIMEOUT=8.0
INLINE_RATE_LIMIT=30

# Environment
ENVIRONMENT=production
DEBUG=false